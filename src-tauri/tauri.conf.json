{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "claudecode-switch",
  "version": "1.0.0",
  "identifier": "switcher.claudecode.dev",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Claude Code Provider Switcher",
        "width": 900,
        "height": 860,
        "x": 100,
        "y": 100,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
